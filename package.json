{
  "name": "coko-server-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "commit": "yarn coko-lint commit --skip-stylelint",
    "lint": "yarn coko-lint run --skip-stylelint",
    "release": "standard-version",
    "test": "docker compose run --rm --remove-orphans server yarn workspace @coko/server test",
    "typecheck": "yarn workspace @coko/server tsc --noEmit -p tsconfig.typecheck.json"
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    }
  },
  "devDependencies": {
    "@coko/lint": "3.0.0-alpha.18",
    "chalk": "^4.1.2",
    "lint-staged": "^15.2.8",
    "lodash": "^4.17.21",
    "standard-version": "^7.1.0"
  },
  "packageManager": "yarn@4.9.2"
}
