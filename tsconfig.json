{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@coko/server": ["./packages/lib/dist"]
    },

    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitAny": false,
    "outDir": "./dist",
    "skipLibCheck": true,
    "strict": false,
    "target": "es2022"
  }
}
